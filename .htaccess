ErrorDocument 404 /404.html

<FilesMatch "\.(js|css)$">
  Header set Cache-Control "no-store, no-cache, must-revalidate"
  Header unset ETag
  FileETag None
</FilesMatch>

# Correct MIME types for ffmpeg.wasm's self-hosted files — the server's
# default mapping was serving .wasm as text/plain and .js as the outdated
# application/x-javascript, which silently stalls WebAssembly instantiation
# and ES module loading in modern browsers instead of erroring outright.
AddType application/wasm .wasm
AddType text/javascript .js .mjs
